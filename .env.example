# SYNCH Environment Configuration

# Server Port
PORT=3000

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=https://synchapp.dev,https://www.synchapp.dev,http://localhost:3000

# JWT Configuration — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Email Configuration (Resend API — recommended). RESEND_KEY is also accepted as an alias.
RESEND_API_KEY=
RESEND_KEY=

# Or SMTP (Gmail app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
# EMAIL_SECRET is also accepted as an alias for EMAIL_PASS
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=SYNCH <noreply@synchapp.dev>

# Database (PostgreSQL — required)
DATABASE_URL=postgres://postgres:password@localhost:5432/synch_web
DB_SSL=false

# Google Sign-In (Google Identity Services)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Twilio (voice/video TURN)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional
ENABLE_LOCAL_HTTPS=false
