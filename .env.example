# SYNCH Environment Configuration

# Server Port
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Email Configuration (Gmail)
# To use Gmail, you need to create an App Password:
# 1. Go to your Google Account settings
# 2. Security > 2-Step Verification (enable if not already)
# 3. Security > App passwords
# 4. Generate a new app password for "Mail"
# 5. Use that 16-character password below

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/synch_web

# Google Sign-In (Google Identity Services)
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Add Authorized JavaScript origins: http://localhost:3000 (Google Sign-In
# only works on localhost or https:// — it will NOT work from a LAN IP like
# http://192.168.x.x:3000, so it auto-hides itself on non-localhost origins).
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
